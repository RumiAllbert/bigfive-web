{
  "name": "bigfive-web",
  "version": "0.0.1",
  "description": "Big Five Personality Assessment - Full Stack Application",
  "main": "dist/lambda/questions.js",
  "scripts": {
    "build": "tsc --project tsconfig-lambda.json",
    "dev": "serverless offline",
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest test/lambda/*.test.ts",
    "test:integration": "jest test/lambda/integration.test.ts",
    "lint": "eslint src/lambda/**/*.ts"
  },
  "dependencies": {
    "@bigfive-org/questions": "^1.3.3",
    "@bigfive-org/results": "^1.2.9",
    "@bigfive-org/score": "^1.2.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.137",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.2",
    "serverless-dotenv-plugin": "^6.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "eslint": "^8.57.0"
  },
  "keywords": [
    "bigfive",
    "personality",
    "assessment",
    "api",
    "aws",
    "lambda",
    "serverless"
  ],
  "author": "Big Five Assessment Team",
  "license": "MIT"
}
